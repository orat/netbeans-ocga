    <version>1.1-SNAPSHOT</version>
    <artifactId>netbeans-ocga</artifactId>
    <packaging>nbm</packaging>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <!-- this plugin registers the nbm packaging type -->
                <artifactId>nbm-maven-plugin</artifactId>
                <version>14.4</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- NetBeans scannt die Projektdateien und initialisiert 
                         die Truffle-Bibliotheken im Hintergrund, noch bevor die 
                         Plugin-Klasse überhaupt geladen werden Zu diesem Zeitpunkt 
                         ist die Klassenisolation der JVM bereits aktiv und lässt 
                         sich nachträglich nicht mehr per System.setProperty() 
                         abschalten.Da dies innerhalb der NetBeans-IDE geschieht, 
                         muss die Optionen für die Laufzeitumgebung (JVM) der 
                         Testinstanz erzwungen werden.-->
                    <!--netbeansArgs>-J-Dpolyglotimpl.DisableClassPathIsolation=true</netbeansArgs-->
                    <!-- Deaktiviert die strikte Classpath-Verifizierung bei externen Klassen -->
                    <!-- Verhindert den Build-Abbruch, da Truffle-Klassen dynamisch bereitgestellt werden -->
                    <verifyRuntime>warn</verifyRuntime>
                    <requiresRestart>true</requiresRestart>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--version>3.8.1</version-->
                <!--version>3.13.0</version-->
                <version>3.15.0</version>
                <configuration>
                    <compilerArgument>-proc:full</compilerArgument>
                    <!--source>21</source>
                    <target>21</target-->
                    <!--compilerArgs>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs-->
                    <compilerArgs>
                        <arg>-Xlint</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <!-- benötigt für nbm packaging -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <!-- The generator is executed during the build only.  Do not
                         ship its GA API references with the NetBeans module. -->
                    <excludes>
                        <exclude>de/orat/math/netbeans/ga/algebra/GaGrammarGenerator.class</exclude>
                    </excludes>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>generate-algebra-grammars</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>de.orat.math.netbeans.ga.algebra.GaGrammarGenerator</mainClass>
                            <!-- GACalcAPI and its factory implementations are
                                 provided dependencies: available for grammar
                                 generation, but absent from the installed module. -->
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
