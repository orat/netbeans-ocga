    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <!-- this plugin registers the nbm packaging type -->
                <artifactId>nbm-maven-plugin</artifactId>
                <version>14.4</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- NetBeans scannt die Projektdateien und initialisiert 
                         die Truffle-Bibliotheken im Hintergrund, noch bevor die 
                         Plugin-Klasse überhaupt geladen werden Zu diesem Zeitpunkt 
                         ist die Klassenisolation der JVM bereits aktiv und lässt 
                         sich nachträglich nicht mehr per System.setProperty() 
                         abschalten.Da dies innerhalb der NetBeans-IDE geschieht, 
                         muss die Optionen für die Laufzeitumgebung (JVM) der 
                         Testinstanz erzwungen werden.-->
                    <!--netbeansArgs>-J-Dpolyglotimpl.DisableClassPathIsolation=true</netbeansArgs-->
                    <!-- Deaktiviert die strikte Classpath-Verifizierung bei externen Klassen -->
                    <!-- Verhindert den Build-Abbruch, da Truffle-Klassen dynamisch bereitgestellt werden -->
                    <verifyRuntime>warn</verifyRuntime>
                    <!-- Expose the truffle language classes to the NetBeans runtime -->
                    <!--publicPackages>
                        <publicPackage>de.dhbh.rahmlab.dsl4ga.impl.truffle.*</publicPackage>
                    </publicPackages-->
                    <!-- testweise 
                         Standardmäßig erlaubt NetBeans einem Modul nur den Zugriff 
                         auf Klassen, die ein anderes Modul explizit als öffentliche 
                         API freigegeben hat.Mit <type>impl</type> deklarierst du eine 
                         sogenannte Implementation Dependency.Das bedeutet: Dein Modul 
                         darf alle internen, privaten und experimentellen Klassen des 
                         Moduls org.netbeans.libs.truffleapi direkt sehen und nutzen 
                         (auch solche, die nicht im offiziellen JavaDoc stehen). Da der 
                         GraalVM-In-Process-LSP tief auf interne APIs (wie den Service-Provider PolyglotImpl) 
                         zugreifen muss, ist dies oft zwingend notwendig.-->
                    <!-- Erzwingt exakt dieselbe Classloader-Ebene -->
                    <moduleDependencies>
                        <dependency>
                            <id>org.netbeans.libs.truffleapi</id>
                            <type>impl</type> 
                        </dependency>
                        <dependency>
                            <id>org.netbeans.libs.graalsdk</id>
                            <type>impl</type>
                    </dependency>
                    </moduleDependencies>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--version>3.8.1</version-->
                <!--version>3.13.0</version-->
                <version>3.15.0</version>
                <configuration>
                    <compilerArgument>-proc:full</compilerArgument>
                    <!--source>21</source>
                    <target>21</target-->
                    <!--compilerArgs>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs-->
                    <compilerArgs>
                        <arg>-Xlint</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- benötigt für nbm packaging -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>generate-algebra-grammars</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>de.orat.math.netbeans.ga.algebra.GaGrammarGenerator</mainClass>
                            <classpathScope>runtime</classpathScope>
                            <arguments>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
