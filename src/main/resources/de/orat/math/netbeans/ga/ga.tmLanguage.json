{
	"name": "ga",
    "scopeName": "text.ga",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#symbols"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
                {
                    "name": "comment.block.ga",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "begin": "(^\\s+)?(?=//)",
                    "end": "(?=$)",
                    "patterns": [
                        {
                            "name": "comment.line.double-slash.ga",
                            "begin": "(?<!/)//(?:(?!/)|(?=//))",
                            "end": "(?=$)"
                        }
                    ]
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.base-secondary.ga",
					"match": "∧|\\+|-|⌋|⌊|∨|/"
				},
				{
					"name": "keyword.operator.add-secondary.ga",
					"match": "⋅|∩|∪"
				},
				{
					"name": "keyword.operator.base-primary.ga",
					"match": "(?<!\\s)(⁻¹|\\*|†|˜)"
				},
				{
					"name": "keyword.operator.add-primary.ga",
					"match": "(?<!\\s)(⁻\\*|²|\\^)"
				},
				{
                    "name": "keyword.operator.assignment.ga",
                    "match": ":="
                }
			]
		},
		"functions": {
			"begin": "((dot|ip|scp|up|down|exp|log|normalize|norm|abs|sqrt|atan2|negate14|tan|sin|sinh|cos|cosh|atan|asin|acos|sign)|(translator|rotator))\\(",
			"beginCaptures": {
				"2": {
					"name": "entity.name.function.base.ga"
				},
				"3": {
					"name": "entity.name.function.additional.ga"
				}
			},
			"end": "\\)",
			"patterns": [
				{
					"include": "#operators"
				},
				{
					"include": "#symbols"
				}
			]
		},
		"variables": {
			"match": "(^\\w+?)(?=\\s*?:=)",
			"captures": {
				"1": {
					"name": "variable.parameter.ga"
				}
			}
		},
		"symbols": {
			"patterns": [
				{
					"name": "constant.language.base-vector.ga",
					"match": "ε(₀|ᵢ|₁|₂|₃)"
				},
				{
					"name": "constant.numeric.ga",
					"match": "π|∞"
				},
				{
					"name": "constant.language.add-vector.ga",
					"match": "(?<!\\w)(o|n|E)(?!\\w)|ñ|E(₀|₃)"
				}
			]
		}
	}
}
